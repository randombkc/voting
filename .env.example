# ─────────────────────────────────────────────
# Perizia-Crux Voting Platform — Environment Variables
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local or any file containing real secrets.
# ─────────────────────────────────────────────

# ── Application ───────────────────────────────
# The public URL of the deployed application (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Database (PostgreSQL — Step 2+) ───────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/voting?schema=public"

# Temporarily for dev setup. Will be replaced by Admin model.
ADMIN_DEV_PASSWORD="password"

# Gmail SMTP Email Configuration (temporary one-day voting event)
GMAIL_USER="your-gmail-address@gmail.com"
GMAIL_APP_PASSWORD="your-16-character-gmail-app-password"
EMAIL_FROM="your-gmail-address@gmail.com"

# ── Prisma (Step 2+) ───────────
# No additional variables required beyond DATABASE_URL

# ── Authentication (future step) ──────────────
# AUTH_SECRET=replace-with-a-secure-random-string

# ── Email / OTP (future step) ─────────────────
# EMAIL_FROM=noreply@example.com
# EMAIL_SERVER=smtp://USER:PASS@smtp.example.com:587

# -- Admin (Temp) ------------------------------
ADMIN_DEV_PASSWORD=devpassword123
